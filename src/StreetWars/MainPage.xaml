<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StreetWars.MainPage"
    Title="StreetWars">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="STREETWARS" FontSize="28" FontAttributes="Bold" />
            <Label Text="Domine 3 dos 5 territórios para vencer." />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Criar" Clicked="CreateRoomClicked" />
                <Button Text="Entrar" Clicked="JoinSelectedRoomClicked" />
                <Button Text="Atualizar" Clicked="RefreshRoomsClicked" />
                <Button Text="Vs IA" Clicked="CreateAiClicked" />
            </HorizontalStackLayout>

            <Label Text="Salas disponíveis" FontAttributes="Bold" />
            <CollectionView
                x:Name="RoomsView"
                HeightRequest="180"
                SelectionMode="Single"
                SelectionChanged="RoomSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Id}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Players, StringFormat='Jogadores: {0}'}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="SessionEntry" IsReadOnly="True" Placeholder="Session ID" />
                <Entry Grid.Column="1" x:Name="PlayerEntry" IsReadOnly="True" WidthRequest="80" Placeholder="Player" />
            </Grid>

            <Label x:Name="StatusLabel" FontAttributes="Bold" />
            <Label x:Name="ScoreLabel" />

            <CollectionView x:Name="PlayersView" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="2">
                            <Label Text="{Binding Id, StringFormat='Player {0}'}" />
                            <Label Text="{Binding Life, StringFormat='Vida: {0}'}" />
                            <Label Text="{Binding Mana, StringFormat='Mana: {0}'}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="TerritoriesView" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="2">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Controller, StringFormat='Controlador: {0}'}" />
                                <Label Text="{Binding Occupants.Count, StringFormat='Ocupantes: {0}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Sua mão" FontAttributes="Bold" />
            <HorizontalStackLayout x:Name="HandLayout" Spacing="6" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry x:Name="TerritoryEntry" Placeholder="Território 0-4" Keyboard="Numeric" />
                <Button Grid.Column="1" Text="Jogar carta" Clicked="PlayClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <Entry x:Name="AttackerEntry" Placeholder="ID atacante" />
                <Entry Grid.Column="1" x:Name="TargetEntry" Placeholder="ID alvo" />
                <Button Grid.Column="2" Text="Atacar" Clicked="AttackClicked" />
            </Grid>

            <Button Text="Finalizar turno" Clicked="EndTurnClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>